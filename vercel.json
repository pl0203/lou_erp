{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/pilot-database": true,
      "fix/pilot-scale-sql": false,
      "ci/customer-categories-postgres": false,
      "ci/ihr-leave-postgres": false,
      "qa/ihr-leave-ui-20261005": true
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/candidate.html"
    }
  ],
  "buildCommand": "node qa/ihr-leave/build.mjs",
  "outputDirectory": "dist-ihr-leave-qa",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; frame-src 'self'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}
